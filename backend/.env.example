# Project / runtime
# development | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# Docker/PostgreSQL
COMPOSE_PROJECT_NAME=taskteddy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskteddy
POSTGRES_PORT=5433

# Backend database URL (local run)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/taskteddy

# Redis (rate limiting, OTP store, token revocation). Note: variable name is
# case-sensitive and MUST be REDIS_URL (uppercase) to be picked up.
REDIS_URL=redis://localhost:6379/0

# Auth
# REQUIRED in production. Must be >= 32 chars and STABLE across restarts/workers,
# otherwise every issued token is invalidated on restart.
# Generate: python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION=7200
FIREBASE_VERIFY_TOKENS=false

# Push notifications (FCM). Leave unset to disable push (dev). In production set
# to the path of your Firebase service-account JSON inside the container.
FIREBASE_CREDENTIALS_FILE=

# Admin panel credentials
# REQUIRED in production. Never ship a default password.
ADMIN_EMAIL=admin@example.com
# Provide EITHER a bcrypt hash (preferred) OR a plaintext password.
# Hash: python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# S3 Storage (for production file uploads)
# Set USE_S3=true in production to use S3 instead of local storage
USE_S3=false
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT_URL=  # Optional: for MinIO or custom S3-compatible storage
S3_PUBLIC_URL=  # Optional: CloudFront domain or custom domain for CDN

# API behavior
# In production, "*" is ignored and CORS is disabled — set explicit origins.
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=support@taskteddy.com
EMAIL_FROM_NAME=TaskTeddy
SENDGRID_EMAIL_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxx

# SMS OTP provider. console (default) logs the OTP server-side for local dev.
# Set to msg91 or twilio in production and provide the matching credentials.
SMS_PROVIDER=console
# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TSKTDY
MSG91_OTP_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments (Razorpay — Phase 2)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
