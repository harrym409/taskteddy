<?xml version="1.0" encoding="utf-8"?>
<!--
  Production posture: cleartext (HTTP) traffic is DISABLED by default, so release
  builds can only talk to the backend over HTTPS. Cleartext is permitted only for
  local development hosts (Android emulator host + localhost). For physical-device
  LAN testing over HTTP, use a debug build (the debug manifest allows all cleartext).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- UAT backend (HTTP ELB). Remove once the backend is behind HTTPS. -->
        <domain includeSubdomains="false">uat-taskteddy-602485976.ap-south-1.elb.amazonaws.com</domain>
    </domain-config>
</network-security-config>
